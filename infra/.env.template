# =============================================================================
# CYBERLAB SECURITY INFRASTRUCTURE - ENVIRONMENT VARIABLES
# =============================================================================
#
# IMPORTANT: Copy this file to .env and update the values with your own
#            secure passwords and configuration.
#
#            cp .env.template .env
#
# WARNING:   Never commit the .env file to version control!
#            The .env file should be listed in .gitignore
#
# =============================================================================

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
# Network ranges for the 5-layer defense-in-depth topology
EXTERNAL_NET=10.10.0.0/24
DMZ_NET=10.10.10.0/24
INTERNAL_NET=10.10.20.0/24
SECURITY_NET=10.10.30.0/24
MANAGEMENT_NET=10.10.40.0/24

# -----------------------------------------------------------------------------
# WAZUH SIEM CONFIGURATION
# -----------------------------------------------------------------------------
# Wazuh Indexer (OpenSearch)
WAZUH_INDEXER_PASSWORD=SecretPassword
OPENSEARCH_INITIAL_ADMIN_PASSWORD=SecretPassword

# Wazuh Manager API
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_API_USER=wazuh-wui

# Wazuh Dashboard
WAZUH_DASHBOARD_PASSWORD=kibanaserver
WAZUH_DASHBOARD_USER=kibanaserver

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL - Multi-tenant database for various services
POSTGRES_PASSWORD=SecureP@ssw0rd
POSTGRES_USER=postgres

# Database credentials for individual services
WAZUH_DB_PASSWORD=wazuh_password
THEHIVE_DB_PASSWORD=thehive_password
CORTEX_DB_PASSWORD=cortex_password
ROCKETCHAT_DB_PASSWORD=rocketchat_password

# -----------------------------------------------------------------------------
# LDAP / DIRECTORY SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# OpenLDAP Configuration
LDAP_ORGANISATION=CyberLab
LDAP_DOMAIN=cyberlab.local
LDAP_BASE_DN=dc=cyberlab,dc=local

# LDAP Admin Credentials
LDAP_ADMIN_PASSWORD=admin
LDAP_CONFIG_PASSWORD=config
LDAP_READONLY_USER_PASSWORD=readonly

# LDAP Bind DN for service accounts
LDAP_BIND_DN=cn=admin,dc=cyberlab,dc=local

# -----------------------------------------------------------------------------
# GRAFANA MONITORING CONFIGURATION
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Grafana Database (if using PostgreSQL instead of SQLite)
GRAFANA_DB_PASSWORD=grafana_password

# -----------------------------------------------------------------------------
# PROMETHEUS CONFIGURATION
# -----------------------------------------------------------------------------
# Prometheus doesn't require a password by default
# But you can add basic auth if needed
PROMETHEUS_ADMIN_PASSWORD=prometheus_password

# -----------------------------------------------------------------------------
# ROCKETCHAT CONFIGURATION
# -----------------------------------------------------------------------------
ROCKETCHAT_PASSWORD=admin
ROCKETCHAT_ADMIN_EMAIL=admin@cyberlab.local
ROCKETCHAT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# THEHIVE & CORTEX CONFIGURATION
# -----------------------------------------------------------------------------
# TheHive API Key
THEHIVE_API_KEY=your-secret-api-key-here

# Cortex API Key
CORTEX_API_KEY=your-cortex-api-key-here

# TheHive Secret
THEHIVE_SECRET=your-thehive-secret-here

# Cortex Secret
CORTEX_SECRET=your-cortex-secret-here

# -----------------------------------------------------------------------------
# AI ANALYZER CONFIGURATION
# -----------------------------------------------------------------------------
# OpenSearch connection for AI analyzer
AI_OPENSEARCH_HOST=https://wazuh.indexer:9200
AI_OPENSEARCH_USER=admin
AI_OPENSEARCH_PASSWORD=SecretPassword

# Ollama LLM configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama2

# AI Analyzer alert settings
AI_ALERT_THRESHOLD=0.8
AI_ANALYSIS_INTERVAL=300

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------
# Restic backup repository password
BACKUP_PASSWORD=SecureBackupP@ss

# Backup repository location (can be S3, Azure, etc.)
BACKUP_REPOSITORY=/backup-repo

# Backup schedule (cron format: minute hour day month weekday)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention policy
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_WEEKS=12
BACKUP_RETENTION_MONTHS=12
BACKUP_RETENTION_YEARS=3

# -----------------------------------------------------------------------------
# FREERADIUS AAA CONFIGURATION
# -----------------------------------------------------------------------------
# RADIUS shared secret for network devices
RADIUS_SECRET=testing123
RADIUS_CLIENTS_SECRET=secret

# -----------------------------------------------------------------------------
# NGINX CONFIGURATION
# -----------------------------------------------------------------------------
# SSL/TLS Configuration
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3
NGINX_SSL_CIPHERS=HIGH:!aNULL:!MD5

# Basic Auth (if needed)
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=nginx_password

# -----------------------------------------------------------------------------
# WIREGUARD VPN CONFIGURATION
# -----------------------------------------------------------------------------
# WireGuard Settings
WIREGUARD_PEERS=10
WIREGUARD_INTERNAL_SUBNET=10.13.13.0/24
WIREGUARD_PORT=51820
WIREGUARD_PEERDNS=auto

# Server public key (generated on first run)
WIREGUARD_SERVERURL=auto

# -----------------------------------------------------------------------------
# NEUVECTOR CONFIGURATION
# -----------------------------------------------------------------------------
# NeuVector credentials (default admin credentials)
NEUVECTOR_ADMIN_USER=admin
NEUVECTOR_ADMIN_PASSWORD=admin

# Controller settings
NEUVECTOR_CTRL_PERSIST_CONFIG=1

# Access NeuVector from host
# NeuVector UI/API is usually exposed on 8443 by default in the compose file.
NEUVECTOR_HOST=localhost
NEUVECTOR_PORT=8443
NEUVECTOR_API_BASE=/api/v1

# Allow NeuVector policies to reference the host IP or CIDR you wish to allow
# Example for Mac host: HOST_ACCESS_CIDR=host.docker.internal/32 or 192.168.1.100/32
HOST_ACCESS_CIDR=127.0.0.1/32

# -----------------------------------------------------------------------------
# SURICATA IDS/IPS CONFIGURATION
# -----------------------------------------------------------------------------
# Home network definition
SURICATA_HOME_NET=10.10.0.0/16

# External network definition
SURICATA_EXTERNAL_NET=!$HOME_NET

# Rule update settings
SURICATA_UPDATE_INTERVAL=86400

# -----------------------------------------------------------------------------
# T-POT HONEYPOT CONFIGURATION
# -----------------------------------------------------------------------------
# T-Pot Web UI credentials
TPOT_WEB_USER=admin
TPOT_WEB_PASSWORD=tpot_password

# -----------------------------------------------------------------------------
# TIMEZONE CONFIGURATION
# -----------------------------------------------------------------------------
# Default timezone for all services
TZ=UTC

# Alternative timezone examples:
# TZ=America/New_York
# TZ=Europe/London
# TZ=Asia/Tokyo
# TZ=Australia/Sydney

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Syslog server for centralized logging (Wazuh Manager)
SYSLOG_SERVER=10.10.30.20
SYSLOG_PORT=514

# Log level for various services
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SECURITY HARDENING
# -----------------------------------------------------------------------------
# Fail2ban settings (if implemented)
FAIL2BAN_MAXRETRY=5
FAIL2BAN_BANTIME=3600
FAIL2BAN_FINDTIME=600

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# SMTP server for email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=cyberlab@example.com
SMTP_TLS=true

# Alert recipients
ALERT_EMAIL=admin@example.com
SECURITY_EMAIL=security@example.com

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# VirusTotal API Key (for TheHive/Cortex analyzers)
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# AbuseIPDB API Key
ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# Shodan API Key
SHODAN_API_KEY=your-shodan-api-key

# Censys API ID and Secret
CENSYS_API_ID=your-censys-api-id
CENSYS_API_SECRET=your-censys-api-secret

# MaxMind GeoIP License Key
MAXMIND_LICENSE_KEY=your-maxmind-license-key

# -----------------------------------------------------------------------------
# DEVELOPMENT/TESTING FLAGS
# -----------------------------------------------------------------------------
# Set to 'true' to enable debug mode for various services
DEBUG_MODE=false

# Enable development mode (less strict security, more verbose logging)
DEV_MODE=false

# Skip SSL verification (ONLY for testing, NEVER in production)
SSL_VERIFY=true

# -----------------------------------------------------------------------------
# RESOURCE LIMITS (Optional overrides)
# -----------------------------------------------------------------------------
# Override default CPU and memory limits
# Format: service_name_CPU_LIMIT, service_name_MEMORY_LIMIT

# Example:
# WAZUH_INDEXER_CPU_LIMIT=2.0
# WAZUH_INDEXER_MEMORY_LIMIT=4G
# WAZUH_MANAGER_CPU_LIMIT=2.0
# WAZUH_MANAGER_MEMORY_LIMIT=4G

# -----------------------------------------------------------------------------
# CUSTOM CONFIGURATION
# -----------------------------------------------------------------------------
# Add any custom environment variables below this line
# These can be referenced in your custom scripts or configurations

# Custom domain for services
DOMAIN=cyberlab.local

# Custom DNS servers
DNS_SERVERS=8.8.8.8,8.8.4.4

# Custom NTP servers
NTP_SERVERS=pool.ntp.org

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
