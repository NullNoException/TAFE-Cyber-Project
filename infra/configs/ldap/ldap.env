# OpenLDAP Environment Configuration
# CyberLab Directory Service

# LDAP Organization Settings
LDAP_ORGANISATION=CyberLab
LDAP_DOMAIN=cyberlab.local
LDAP_BASE_DN=dc=cyberlab,dc=local

# Admin Credentials
LDAP_ADMIN_USERNAME=admin
# LDAP_ADMIN_PASSWORD should be set from Docker secrets or .env
LDAP_ADMIN_CN=cn=admin,dc=cyberlab,dc=local

# Configuration Password
# LDAP_CONFIG_PASSWORD should be set from Docker secrets or .env
LDAP_CONFIG_CN=cn=config

# TLS/SSL Settings
LDAP_TLS_ENABLED=true
LDAP_TLS_VERIFY_CLIENT=try
LDAP_TLS_PROTOCOL_MIN=3.3

# Server Settings
LDAP_SERVER_ADMIN=admin@cyberlab.local
LDAP_LOG_LEVEL=256

# Replication Settings (if needed)
LDAP_REPLICATION_ENABLED=false
LDAP_REPLICATION_USER=replicator
# LDAP_REPLICATION_PASSWORD from secrets

# Access Control
LDAP_PPOLICY_ENABLED=true
LDAP_PPOLICY_HASH_CLEARTEXT=false

# Data Directory
LDAP_DATA_DIR=/var/lib/ldap
LDAP_CONFIG_DIR=/etc/ldap/slapd.d

# Backup Settings
LDAP_BACKUP_ENABLED=true
LDAP_BACKUP_DIR=/var/backups/ldap
LDAP_BACKUP_RETENTION_DAYS=30

# Performance Tuning
LDAP_THREAD_POOL_SIZE=8
LDAP_CACHE_SIZE=524288
LDAP_DB_MAX_SIZE=1073741824
