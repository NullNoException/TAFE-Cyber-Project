# ============================================================================
# ADDITIONAL SECURITY RULES (1001000-1001100)
# ============================================================================

# DDoS Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS SYN Flood Detected"; flow:to_server; flags:S; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001000; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS ICMP Flood Detected"; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001001; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS UDP Flood Detected"; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001002; rev:1;)

# Zero-Day Detection
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible Zero-Day Attack Pattern"; flow:to_server,established; classtype:suspicious-activity; sid:1001003; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Potential Shellcode Execution"; classtype:suspicious-activity; sid:1001004; rev:1;)

# Vulnerability Scanning
