# LATERAL MOVEMENT & POST-EXPLOITATION (1000700-1000799)
# ============================================================================

alert tcp $HOME_NET any -> $HOME_NET 389 (msg:"LDAP Lateral Movement Detection"; flow:to_server,established; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000700; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"SMB Lateral Movement - Admin Shares"; flow:to_server,established; content:"IPC$"; classtype:attempted-admin; sid:1000701; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"SSH Lateral Movement - Key Authentication"; flow:to_server,established; content:"SSH-2.0"; classtype:attempted-admin; sid:1000702; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ICMP Tunnel Detection"; icmp_type: 8; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000703; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"DNS Tunnel Detection"; flow:to_server,established; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000704; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"HTTP Tunnel Detection"; flow:to_server,established; content:"HTTP/1.1"; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000705; rev:1;)
