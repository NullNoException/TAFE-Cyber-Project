alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Nessus Vulnerability Scanner Detected"; content:"Nessus"; classtype:attempted-recon; sid:1001006; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Qualys Scanner Detected"; content:"Qualys"; classtype:attempted-recon; sid:1001007; rev:1;)

# Suspicious Process Execution
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - Powershell Execution"; content:"powershell"; nocase; classtype:suspicious-activity; sid:1001008; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - CMD Execution"; content:"cmd.exe"; nocase; classtype:suspicious-activity; sid:1001009; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - Encoded Scripts"; content:"base64"; nocase; classtype:suspicious-activity; sid:1001010; rev:1;)
