alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Buffer Overflow Attempt"; classtype:attempted-admin; sid:1000500; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Shellcode Detection"; content:"!("; classtype:attempted-admin; sid:1000501; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"ET EXPLOIT EternalBlue/SMBv3 Exploit Attempt"; flow:to_server,established; classtype:attempted-admin; sid:1000502; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Heartbleed SSL Vulnerability"; flow:to_server,established; classtype:attempted-admin; sid:1000503; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Privilege Escalation Attempt"; classtype:attempted-admin; sid:1000504; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"ET EXPLOIT RDP Bluekeep Vulnerability"; flow:to_server,established; classtype:attempted-admin; sid:1000505; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT XXE Injection"; content:"<!ENTITY"; nocase; classtype:attempted-admin; sid:1000506; rev:1;)
