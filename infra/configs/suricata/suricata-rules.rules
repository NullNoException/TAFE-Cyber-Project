alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Directory Traversal"; content:"../"; nocase; classtype:attempted-admin; sid:1000508; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Path Traversal"; content:"..\\"; classtype:attempted-admin; sid:1000509; rev:1;)

# ============================================================================
# WEB APPLICATION ATTACKS (1000600-1000699)
# ============================================================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - Script Tag"; flow:to_server,established; content:"GET"; http_method; content:"<script"; nocase; classtype:web-application-attack; sid:1000600; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - IMG Tag"; flow:to_server,established; content:"GET"; http_method; content:"<img"; nocase; classtype:web-application-attack; sid:1000601; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - SVG Vector"; flow:to_server,established; content:"GET"; http_method; content:"<svg"; nocase; classtype:web-application-attack; sid:1000602; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK CSRF Token Bypass"; flow:to_server,established; content:"POST"; http_method; classtype:web-application-attack; sid:1000603; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XXS - Event Handler"; flow:to_server,established; content:"onload"; nocase; classtype:web-application-attack; sid:1000604; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK Path Traversal - Directory Escape"; flow:to_server,established; content:"GET"; http_method; content:"....//"; classtype:web-application-attack; sid:1000605; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK File Inclusion - Local"; flow:to_server,established; content:"GET"; http_method; content:"/etc/passwd"; nocase; classtype:web-application-attack; sid:1000606; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK File Inclusion - Remote"; flow:to_server,established; content:"GET"; http_method; content:"http://"; classtype:web-application-attack; sid:1000607; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK Insecure Deserialization"; flow:to_server,established; content:"POST"; http_method; content:"serialized"; nocase; classtype:web-application-attack; sid:1000608; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XML External Entity Injection"; flow:to_server,established; content:"POST"; http_method; content:"DOCTYPE"; classtype:web-application-attack; sid:1000609; rev:1;)

