alert dns $EXTERNAL_NET any -> $HOME_NET 53 (msg:"DNS Tunneling Detection"; dns_query; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1000900; rev:1;)
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"DNS Exfiltration Detection"; dns_query; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1000901; rev:1;)
