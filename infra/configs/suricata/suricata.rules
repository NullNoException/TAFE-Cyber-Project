alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Buffer Overflow Attempt"; classtype:attempted-admin; sid:1000500; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Shellcode Detection"; content:"!("; classtype:attempted-admin; sid:1000501; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"ET EXPLOIT EternalBlue/SMBv3 Exploit Attempt"; flow:to_server,established; classtype:attempted-admin; sid:1000502; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Heartbleed SSL Vulnerability"; flow:to_server,established; classtype:attempted-admin; sid:1000503; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Privilege Escalation Attempt"; classtype:attempted-admin; sid:1000504; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"ET EXPLOIT RDP Bluekeep Vulnerability"; flow:to_server,established; classtype:attempted-admin; sid:1000505; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT XXE Injection"; content:"<!ENTITY"; nocase; classtype:attempted-admin; sid:1000506; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT SSRF Attack"; content:"localhost"; nocase; classtype:attempted-admin; sid:1000507; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Directory Traversal"; content:"../"; nocase; classtype:attempted-admin; sid:1000508; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Path Traversal"; content:"..\\"; classtype:attempted-admin; sid:1000509; rev:1;)

# ============================================================================
# WEB APPLICATION ATTACKS (1000600-1000699)
# ============================================================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - Script Tag"; flow:to_server,established; content:"GET"; http_method; content:"<script"; nocase; classtype:web-application-attack; sid:1000600; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - IMG Tag"; flow:to_server,established; content:"GET"; http_method; content:"<img"; nocase; classtype:web-application-attack; sid:1000601; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XSS - SVG Vector"; flow:to_server,established; content:"GET"; http_method; content:"<svg"; nocase; classtype:web-application-attack; sid:1000602; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK CSRF Token Bypass"; flow:to_server,established; content:"POST"; http_method; classtype:web-application-attack; sid:1000603; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XXS - Event Handler"; flow:to_server,established; content:"onload"; nocase; classtype:web-application-attack; sid:1000604; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK Path Traversal - Directory Escape"; flow:to_server,established; content:"GET"; http_method; content:"....//"; classtype:web-application-attack; sid:1000605; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK File Inclusion - Local"; flow:to_server,established; content:"GET"; http_method; content:"/etc/passwd"; nocase; classtype:web-application-attack; sid:1000606; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK File Inclusion - Remote"; flow:to_server,established; content:"GET"; http_method; content:"http://"; classtype:web-application-attack; sid:1000607; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK Insecure Deserialization"; flow:to_server,established; content:"POST"; http_method; content:"serialized"; nocase; classtype:web-application-attack; sid:1000608; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK XML External Entity Injection"; flow:to_server,established; content:"POST"; http_method; content:"DOCTYPE"; classtype:web-application-attack; sid:1000609; rev:1;)

# ============================================================================
# LATERAL MOVEMENT & POST-EXPLOITATION (1000700-1000799)
# ============================================================================

alert tcp $HOME_NET any -> $HOME_NET 389 (msg:"LDAP Lateral Movement Detection"; flow:to_server,established; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000700; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"SMB Lateral Movement - Admin Shares"; flow:to_server,established; content:"IPC$"; classtype:attempted-admin; sid:1000701; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"SSH Lateral Movement - Key Authentication"; flow:to_server,established; content:"SSH-2.0"; classtype:attempted-admin; sid:1000702; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ICMP Tunnel Detection"; icmp_type: 8; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000703; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"DNS Tunnel Detection"; flow:to_server,established; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000704; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"HTTP Tunnel Detection"; flow:to_server,established; content:"HTTP/1.1"; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-admin; sid:1000705; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 5985 (msg:"WinRM Remote Access - Port 5985"; flow:to_server,established; classtype:attempted-admin; sid:1000706; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 5986 (msg:"WinRM Remote Access - Port 5986"; flow:to_server,established; classtype:attempted-admin; sid:1000707; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Privilege Escalation - Sudo Abuse"; content:"sudo"; classtype:attempted-admin; sid:1000708; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Privilege Escalation - SetUID Binary"; classtype:attempted-admin; sid:1000709; rev:1;)

# ============================================================================
# EXFILTRATION & DATA THEFT (1000800-1000899)
# ============================================================================

alert tcp $HOME_NET any -> $EXTERNAL_NET 25 (msg:"Data Exfiltration - SMTP to External"; flow:to_server,established; threshold:type both, track by_src, count 10, seconds 60; classtype:suspicious-activity; sid:1000800; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 587 (msg:"Data Exfiltration - SMTP TLS to External"; flow:to_server,established; threshold:type both, track by_src, count 10, seconds 60; classtype:suspicious-activity; sid:1000801; rev:1;)
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"Data Exfiltration - DNS Tunneling"; dns_query; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1000802; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - Large File Transfer"; flow:to_server,established; threshold:type both, track by_src, count 1000, seconds 60; classtype:suspicious-activity; sid:1000803; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - Cloud Storage Upload"; flow:to_server,established; content:"s3.amazonaws.com"; classtype:suspicious-activity; sid:1000804; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Data Exfiltration - HTTPS to Unknown"; flow:to_server,established; threshold:type both, track by_dst, count 50, seconds 60; classtype:suspicious-activity; sid:1000805; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - FTP to External"; flow:to_server,established; threshold:type both, track by_src, count 5, seconds 60; classtype:suspicious-activity; sid:1000806; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - SSH to External"; flow:to_server,established; content:"SSH-2.0"; threshold:type both, track by_src, count 5, seconds 60; classtype:suspicious-activity; sid:1000807; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - Keylog Transmission"; classtype:suspicious-activity; sid:1000808; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - Credential Harvesting"; content:"password"; nocase; classtype:suspicious-activity; sid:1000809; rev:1;)

# ============================================================================
# DNS & PROTOCOL ANOMALIES (1000900-1000999)
# ============================================================================

alert dns $EXTERNAL_NET any -> $HOME_NET 53 (msg:"DNS Tunneling Detection"; dns_query; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1000900; rev:1;)
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"DNS Exfiltration Detection"; dns_query; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1000901; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 53 (msg:"DNS Zone Transfer Attempt"; content:"AXFR"; classtype:attempted-recon; sid:1000902; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET 53 (msg:"DNS Amplification Attack"; threshold:type both, track by_dst, count 100, seconds 60; classtype:denial-of-service; sid:1000903; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Protocol Anomaly - Zero-Length Packet"; classtype:suspicious-activity; sid:1000904; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Protocol Anomaly - Invalid TCP Flags"; flags:FPU; classtype:suspicious-activity; sid:1000905; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Protocol Anomaly - Suspicious Fragment"; classtype:suspicious-activity; sid:1000906; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Protocol Anomaly - Possible Data Exfiltration"; threshold:type both, track by_src, count 1000000, seconds 60; classtype:suspicious-activity; sid:1000907; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Suspicious TLS Handshake - SSL Version Probe"; classtype:suspicious-activity; sid:1000908; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Suspicious Outbound Connection - High Port"; flow:to_server,established; threshold:type both, track by_dst, count 50, seconds 60; classtype:suspicious-activity; sid:1000909; rev:1;)

# ============================================================================
# ADDITIONAL SECURITY RULES (1001000-1001100)
# ============================================================================

# DDoS Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS SYN Flood Detected"; flow:to_server; flags:S; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001000; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS ICMP Flood Detected"; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001001; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDOS UDP Flood Detected"; threshold:type both, track by_dst, count 1000, seconds 10; classtype:denial-of-service; sid:1001002; rev:1;)

# Zero-Day Detection
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible Zero-Day Attack Pattern"; flow:to_server,established; classtype:suspicious-activity; sid:1001003; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Potential Shellcode Execution"; classtype:suspicious-activity; sid:1001004; rev:1;)

# Vulnerability Scanning
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"OpenVAS Vulnerability Scanner Detected"; content:"OpenVAS"; classtype:attempted-recon; sid:1001005; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Nessus Vulnerability Scanner Detected"; content:"Nessus"; classtype:attempted-recon; sid:1001006; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Qualys Scanner Detected"; content:"Qualys"; classtype:attempted-recon; sid:1001007; rev:1;)

# Suspicious Process Execution
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - Powershell Execution"; content:"powershell"; nocase; classtype:suspicious-activity; sid:1001008; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - CMD Execution"; content:"cmd.exe"; nocase; classtype:suspicious-activity; sid:1001009; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"Suspicious Process - Encoded Scripts"; content:"base64"; nocase; classtype:suspicious-activity; sid:1001010; rev:1;)

# =============================================================================
# ADVANCED ATTACK SCENARIOS (1001100-1001200)
# Complex multi-stage attacks and lateral movement patterns
# =============================================================================

# Post-Exploitation and Persistence
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LATERAL-MOVE: Mimikatz Password Extraction Indicators"; content:"mimikatz"; nocase; classtype:attempted-admin; sid:1001100; rev:1; metadata: description "Mimikatz tool usage detected - credential theft framework.";)

alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"LATERAL-MOVE: Named Pipe Enumeration - Lateral Movement"; content:"\\"; content:"pipe"; nocase; classtype:attempted-admin; sid:1001101; rev:1; metadata: description "SMB named pipe access for lateral movement via PSEXEC.";)

alert tcp $HOME_NET any -> $HOME_NET 21 (msg:"DATA-THEFT: FTP Anonymous Login Attempt"; content:"USER"; nocase; content:"anonymous"; nocase; classtype:suspicious-activity; sid:1001102; rev:1; metadata: description "Anonymous FTP authentication for unauthorized data access.";)

# Web Application Exploitation
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB-ATTACK: Path Traversal Exploitation - Directory Escape"; flow:to_server,established; content:"GET"; http_method; pcre:"/\.\.%2f|\.\.\/|\.\.\\{2,}/i"; classtype:web-application-attack; sid:1001103; rev:2; metadata: description "Path traversal patterns attempting to escape webroot.";)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB-ATTACK: LFI Exploitation - /etc/passwd Access"; flow:to_server,established; content:"GET"; http_method; pcre:"/\/etc\/(passwd|shadow|hosts|hostname)/i"; classtype:web-application-attack; sid:1001104; rev:2; metadata: description "Local file inclusion attack targeting sensitive system files.";)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB-ATTACK: RFI Exploitation - Remote Script Inclusion"; flow:to_server,established; content:"GET"; http_method; pcre:"/https?:\/\/[^\s]+\.(php|asp|jsp|py)/i"; classtype:web-application-attack; sid:1001105; rev:2; metadata: description "Remote file inclusion from external URLs in parameters.";)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB-ATTACK: XXE Injection - XML External Entity"; flow:to_server,established; content:"POST"; http_method; pcre:"/<!ENTITY[^>]*SYSTEM\s+['\"](?:file|http):\/\//i"; classtype:web-application-attack; sid:1001106; rev:2; metadata: description "XXE attack attempting to include external entities/DTDs.";)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB-ATTACK: Deserialization Attack - Java Object Gadget"; flow:to_server,established; content:"POST"; http_method; pcre:"/aced00(05|04).*?[Rr]untime.*?exec/i"; classtype:web-application-attack; sid:1001107; rev:2; metadata: description "Java deserialization gadget chain for RCE.";)

# Network-Based Attacks
alert tcp $EXTERNAL_NET any -> $HOME_NET 139 (msg:"NETWORK-ATTACK: NetBIOS Exploitation - System Enumeration"; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:1001108; rev:1; metadata: description "NetBIOS name queries for Windows system discovery.";)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"NETWORK-ATTACK: Slow HTTP DoS - Slowloris Attack"; flow:to_server; content:"GET"; http_method; pcre:"/Keep-Alive:\s*\d{4,}/i"; threshold:type both, track by_src, count 100, seconds 300; classtype:denial-of-service; sid:1001109; rev:1; metadata: description "Slowloris slow HTTP attack holding connections open.";)

alert udp $EXTERNAL_NET any -> $HOME_NET 5353 (msg:"NETWORK-ATTACK: mDNS Enumeration - Service Discovery"; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1001110; rev:1; metadata: description "Multicast DNS queries for local service enumeration.";)

# Encryption & Tunnel Detection
alert tcp $HOME_NET any -> $EXTERNAL_NET !80 !443 (msg:"TUNNEL-DETECTION: Suspicious Encrypted Tunnel - Non-Standard Port"; flow:to_server,established; threshold:type both, track by_dst, count 50, seconds 60; classtype:suspicious-activity; sid:1001111; rev:1; metadata: description "Encrypted tunnel over non-standard port indicates potential C2.";)

alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"TUNNEL-DETECTION: DNS Query Anomaly - Large Response"; dns_query; threshold:type both, track by_src, count 200, seconds 60; classtype:suspicious-activity; sid:1001112; rev:1; metadata: description "Excessive DNS queries potentially used for data exfiltration.";)

# Ransomware Behavior Detection
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"RANSOMWARE: Suspicious File Encryption Patterns"; flow:to_server,established; pcre:"/\.encrypted|\.locked|\.crypted|\.ransom|\.wannacry/i"; classtype:trojan-activity; sid:1001113; rev:1; metadata: description "File extensions associated with ransomware encryption.";)

alert tcp $HOME_NET any -> $EXTERNAL_NET 25 (msg:"RANSOMWARE: Payment Demand Email Transmission"; flow:to_server,established; content:"MAIL"; nocase; threshold:type both, track by_src, count 5, seconds 60; classtype:trojan-activity; sid:1001114; rev:1; metadata: description "SMTP transmission of ransom demands/payment instructions.";)

# Advanced Persistent Threat Detection
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"APT: Command & Control Beacon - Regular Callback"; flow:to_server,established; threshold:type both, track by_dst, count 20, seconds 300; classtype:trojan-activity; sid:1001115; rev:1; metadata: description "Regular outbound connections to external C2 server.";)

alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"APT: HTTPS-Based C2 Communication - Suspicious TLS"; flow:to_server,established; content:"TLS"; pcre:"/[Ss]uspicious|[Rr]everse[Ss]hell|[Bb]eacon/i"; classtype:trojan-activity; sid:1001116; rev:1; metadata: description "HTTPS C2 traffic patterns indicative of APT activity.";)

# Zero-Day and Anomaly Detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ZERO-DAY: Shellcode Injection Pattern - NOP Sled"; flow:to_server; content:"|90 90 90 90|"; classtype:shellcode-detect; sid:1001117; rev:1; metadata: description "NOP sled pattern indicating potential shellcode injection.";)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ZERO-DAY: Heap Spray Attack Signature"; flow:to_server; content:"HEAP"; nocase; threshold:type both, track by_src, count 5, seconds 60; classtype:shellcode-detect; sid:1001118; rev:1; metadata: description "Heap spray pattern for memory corruption exploitation.";)

alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"ANOMALY: Fragmented Packet Reassembly - Evasion Attempt"; flags:M; threshold:type both, track by_src, count 100, seconds 60; classtype:suspicious-activity; sid:1001119; rev:1; metadata: description "Excessive IP fragmentation potentially bypassing IDS detection.";)
