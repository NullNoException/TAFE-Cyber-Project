<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wazuh Honeypot Decoders - Cowrie and Dionaea
  This file contains decoders for parsing JSON logs from SSH/Telnet (Cowrie)
  and multi-protocol (Dionaea) honeypots.
-->

<decoders>

  <!-- =====================================================================
       COWRIE HONEYPOT DECODERS
       Extracts key fields from SSH/Telnet honeypot logs
       ====================================================================== -->

  <!-- Parent decoder for Cowrie JSON logs -->
  <decoder name="cowrie_json">
    <plugin_decoder>true</plugin_decoder>
    <prematch>^{"eventid":</prematch>
  </decoder>

  <!-- Cowrie login attempt (failed or successful) -->
  <decoder name="cowrie_login">
    <parent>cowrie_json</parent>
    <regex>^{"eventid":"cowrie.login.\w+","timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","src_port":(\d+),"dst_ip":"(\d+\.\d+\.\d+\.\d+)","dst_port":(\d+),"username":"([^"]+)","password":"([^"]*)"</regex>
    <order>timestamp, src_ip, src_port, dst_ip, dst_port, username, password</order>
  </decoder>

  <!-- Cowrie successful login -->
  <decoder name="cowrie_login_success">
    <parent>cowrie_login</parent>
    <prematch>cowrie.login.success</prematch>
  </decoder>

  <!-- Cowrie failed login -->
  <decoder name="cowrie_login_failure">
    <parent>cowrie_login</parent>
    <prematch>cowrie.login.failed</prematch>
  </decoder>

  <!-- Cowrie command execution -->
  <decoder name="cowrie_command">
    <parent>cowrie_json</parent>
    <regex>^{"eventid":"cowrie.command.input","timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","session":"([^"]+)","input":"([^"]*)"</regex>
    <order>timestamp, src_ip, session, command</order>
  </decoder>

  <!-- Cowrie file download -->
  <decoder name="cowrie_download">
    <parent>cowrie_json</parent>
    <regex>^{"eventid":"cowrie.session.file_download","timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","filename":"([^"]+)","shasum":"([^"]*)"</regex>
    <order>timestamp, src_ip, filename, file_hash</order>
  </decoder>

  <!-- Cowrie connection close -->
  <decoder name="cowrie_connection_close">
    <parent>cowrie_json</parent>
    <regex>^{"eventid":"cowrie.session.closed","timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","duration":(\d+)}</regex>
    <order>timestamp, src_ip, duration</order>
  </decoder>

  <!-- Cowrie SSH key exchange -->
  <decoder name="cowrie_ssh_key_exchange">
    <parent>cowrie_json</parent>
    <regex>^{"eventid":"cowrie.ssh.key_exchange","timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","host_key_algorithms":"([^"]*)"</regex>
    <order>timestamp, src_ip, algorithms</order>
  </decoder>

  <!-- =====================================================================
       DIONAEA HONEYPOT DECODERS
       Extracts key fields from multi-protocol honeypot logs
       ====================================================================== -->

  <!-- Parent decoder for Dionaea JSON logs -->
  <decoder name="dionaea_json">
    <plugin_decoder>true</plugin_decoder>
    <prematch>^{"timestamp":</prematch>
  </decoder>

  <!-- Dionaea connection attempt (SMB, HTTP, FTP, etc.) -->
  <decoder name="dionaea_connection">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","src_port":(\d+),"dst_ip":"(\d+\.\d+\.\d+\.\d+)","dst_port":(\d+),"protocol":"([^"]+)"</regex>
    <order>timestamp, src_ip, src_port, dst_ip, dst_port, protocol</order>
  </decoder>

  <!-- Dionaea SMB connection -->
  <decoder name="dionaea_smb_connection">
    <parent>dionaea_connection</parent>
    <prematch>"protocol":"smb"</prematch>
  </decoder>

  <!-- Dionaea HTTP request -->
  <decoder name="dionaea_http_request">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","method":"([A-Z]+)","uri":"([^"]+)","user_agent":"([^"]*)"</regex>
    <order>timestamp, src_ip, method, uri, user_agent</order>
  </decoder>

  <!-- Dionaea FTP login attempt -->
  <decoder name="dionaea_ftp_login">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","protocol":"ftp","username":"([^"]+)","password":"([^"]*)"</regex>
    <order>timestamp, src_ip, username, password</order>
  </decoder>

  <!-- Dionaea SQL injection attempt -->
  <decoder name="dionaea_sql_injection">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","attack_type":"sql_injection","payload":"([^"]*)"</regex>
    <order>timestamp, src_ip, payload</order>
  </decoder>

  <!-- Dionaea malware/file download -->
  <decoder name="dionaea_malware">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","file_type":"([^"]+)","file_hash":"([^"]+)","threat_level":"([^"]*)"</regex>
    <order>timestamp, src_ip, file_type, file_hash, threat_level</order>
  </decoder>

  <!-- Dionaea brute force detection -->
  <decoder name="dionaea_brute_force">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","event":"brute_force_detected","protocol":"([^"]+)","attempts":(\d+)"</regex>
    <order>timestamp, src_ip, protocol, attempts</order>
  </decoder>

  <!-- Dionaea MSSQL login attempt -->
  <decoder name="dionaea_mssql_login">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","protocol":"mssql","username":"([^"]+)","password":"([^"]*)"</regex>
    <order>timestamp, src_ip, username, password</order>
  </decoder>

  <!-- Dionaea MySQL login attempt -->
  <decoder name="dionaea_mysql_login">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","protocol":"mysql","username":"([^"]+)","password":"([^"]*)"</regex>
    <order>timestamp, src_ip, username, password</order>
  </decoder>

  <!-- Dionaea RDP connection attempt -->
  <decoder name="dionaea_rdp_connection">
    <parent>dionaea_json</parent>
    <regex>^{"timestamp":"(\d+-\d+-\d+T\d+:\d+:\d+\.\d+Z)","src_ip":"(\d+\.\d+\.\d+\.\d+)","protocol":"rdp","username":"([^"]+)"</regex>
    <order>timestamp, src_ip, username</order>
  </decoder>

</decoders>
