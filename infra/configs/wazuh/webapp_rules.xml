  </rule>

  <!-- Rule 100324: WebGoat RCE Lesson Activity -->
  <rule id="100324" level="6">
    <if_matched_group>webgoat_rce_lesson</if_matched_group>
    <description>WebGoat RCE lesson activity detected (training activity - high risk)</description>
    <mitre>
      <id>T1059</id> <!-- Command and Scripting Interpreter -->
    </mitre>
    <group>webapp_training, rce, learning, high_severity</group>
  </rule>

  <!-- Rule 100325: WebGoat LDAP Lesson Activity -->
  <rule id="100325" level="5">
    <if_matched_group>webgoat_ldap_lesson</if_matched_group>
    <description>WebGoat LDAP Injection lesson activity detected (training activity)</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
    </mitre>
    <group>webapp_training, ldap_injection, learning</group>
  </rule>

  <!-- Rule 100326: WebGoat Path Traversal Lesson Activity -->
  <rule id="100326" level="5">
    <if_matched_group>webgoat_path_lesson</if_matched_group>
    <description>WebGoat Path Traversal lesson activity detected (training activity)</description>
    <mitre>
      <id>T1083</id> <!-- File and Directory Discovery -->
    </mitre>
    <group>webapp_training, path_traversal, learning</group>
  </rule>

  <!-- Rule 100327: WebGoat JWT Lesson Activity -->
  <rule id="100327" level="5">
    <if_matched_group>webgoat_jwt_lesson</if_matched_group>
    <description>WebGoat JWT lesson activity detected (training activity)</description>
    <mitre>
      <id>T1550</id> <!-- Use Alternate Authentication Material -->
    </mitre>
    <group>webapp_training, jwt, learning</group>
  </rule>

  <!-- Rule 100328: WebGoat Sensitive Data Lesson Activity -->
  <rule id="100328" level="5">
    <if_matched_group>webgoat_sensitive_lesson</if_matched_group>
    <description>WebGoat Sensitive Data Exposure lesson activity detected (training activity)</description>
    <mitre>
      <id>T1526</id> <!-- Enumerate External Targets -->
    </mitre>
    <group>webapp_training, data_exposure, learning</group>
  </rule>

  <!-- =====================================================================
       GENERIC WEB APPLICATION ATTACK RULES (100350-100399)
       ===================================================================== -->

  <!-- Rule 100350: HTTP Error Rate Alert -->
  <rule id="100350" level="6">
    <if_matched_group>webapp_http_error</if_matched_group>
    <frequency>10</frequency>
    <timeframe>60</timeframe>
    <description>High rate of HTTP errors detected on web honeypots (possible DDoS or scanning)</description>
    <mitre>
      <id>T1498</id> <!-- Network Denial of Service -->
    </mitre>
    <group>webapp_attack, dos, error_rate</group>
  </rule>

  <!-- Rule 100351: 404 Scanning Pattern -->
  <rule id="100351" level="6">
    <program_name>juice-shop|webgoat</program_name>
    <prematch>404|not found</prematch>
    <frequency>15</frequency>
    <timeframe>60</timeframe>
    <description>Directory/path scanning activity detected on web honeypot</description>
    <mitre>
      <id>T1595</id> <!-- Active Scanning -->
      <id>T1526</id> <!-- Enumerate External Targets -->
    </mitre>
    <group>webapp_attack, scanning, enumeration</group>
  </rule>

  <!-- Rule 100352: SQLi Pattern in Web Honeypot -->
  <rule id="100352" level="8">
    <program_name>juice-shop|webgoat</program_name>
    <prematch>union.*select|select.*from|drop.*table|exec\(|script.*alert</prematch>
    <description>SQL Injection or XSS pattern detected in web honeypot traffic</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
    </mitre>
    <group>webapp_attack, injection</group>
  </rule>

  <!-- Rule 100353: Admin Access Attempt -->
  <rule id="100353" level="7">
    <program_name>juice-shop|webgoat</program_name>
    <prematch>/admin|/administrator|admin.php|admin.jsp|/wp-admin</prematch>
    <description>Admin panel or privileged path access attempt on web honeypot</description>
    <mitre>
      <id>T1078</id> <!-- Valid Accounts -->
    </mitre>
    <group>webapp_attack, privilege_escalation, access_control</group>
  </rule>

  <!-- Rule 100354: Shell/Webshell Upload Attempt -->
  <rule id="100354" level="9">
    <program_name>juice-shop|webgoat</program_name>
    <prematch>shell.php|shell.jsp|webshell|backdoor|.exe|.bat|cmd.exe</prematch>
    <description>Webshell or executable upload attempt detected on web honeypot</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1651</id> <!-- Exploit for Privilege Escalation -->
    </mitre>
    <group>webapp_attack, rce, shell_upload</group>
  </rule>

  <!-- Rule 100355: API Enumeration Activity -->
  <rule id="100355" level="6">
    <program_name>juice-shop|webgoat</program_name>
    <prematch>/api/|/rest/</prematch>
    <frequency>20</frequency>
    <timeframe>60</timeframe>
    <description>API endpoint enumeration detected on web honeypot</description>
    <mitre>
      <id>T1595</id> <!-- Active Scanning -->
      <id>T1526</id> <!-- Enumerate External Targets -->
    </mitre>
    <group>webapp_attack, api_enumeration</group>
  </rule>

  <!-- Rule 100360: Critical Web Honeypot Attack -->
  <rule id="100360" level="10">
    <if_matched_sid>100352|100354</if_matched_sid>
    <description>CRITICAL: Code injection or shell upload attempt detected on web honeypot</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1059</id> <!-- Command and Scripting Interpreter -->
    </mitre>
    <group>webapp_attack, critical, rce</group>
  </rule>

  <!-- Rule 100361: Web Honeypot Daily Summary -->
  <rule id="100361" level="4">
    <if_matched_group>webapp_attack|webapp_training</if_matched_group>
    <frequency>50</frequency>
    <timeframe>86400</timeframe>
    <description>Daily web honeypot activity summary (attacks/training detected)</description>
    <group>webapp_summary, statistics</group>
  </rule>

</group>
