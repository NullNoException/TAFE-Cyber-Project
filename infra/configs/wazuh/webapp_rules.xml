<?xml version="1.0" encoding="UTF-8"?>
<!--
  Web Application Honeypot Detection Rules (IDs: 100300-100399)
  Monitors Juice Shop and WebGoat for exploitation attempts
-->

<group name="webapp_honeypots">

  <!-- =====================================================================
       JUICE SHOP ATTACK DETECTION RULES (100300-100350)
       ===================================================================== -->

  <!-- Rule 100301: SQL Injection Detection -->
  <rule id="100301" level="8">
    <if_matched_group>juice_shop_sql_injection</if_matched_group>
    <description>SQL Injection attack detected on Juice Shop</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1595</id> <!-- Active Scanning -->
    </mitre>
    <group>webapp_attack, injection, database</group>
  </rule>

  <!-- Rule 100302: XSS Attack Detection -->
  <rule id="100302" level="7">
    <if_matched_group>juice_shop_xss_attack</if_matched_group>
    <description>Cross-Site Scripting (XSS) attack detected on Juice Shop</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1059</id> <!-- Command and Scripting Interpreter -->
    </mitre>
    <group>webapp_attack, xss, injection</group>
  </rule>

  <!-- Rule 100303: Path Traversal Attack -->
  <rule id="100303" level="7">
    <if_matched_group>juice_shop_path_traversal</if_matched_group>
    <description>Path Traversal attack detected on Juice Shop</description>
    <mitre>
      <id>T1083</id> <!-- File and Directory Discovery -->
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
    </mitre>
    <group>webapp_attack, path_traversal, file_access</group>
  </rule>

  <!-- Rule 100304: Authentication Bypass Attempt -->
  <rule id="100304" level="8">
    <if_matched_group>juice_shop_auth_bypass</if_matched_group>
    <description>Authentication bypass or privilege escalation attempt on Juice Shop</description>
    <mitre>
      <id>T1110</id> <!-- Brute Force -->
      <id>T1078</id> <!-- Valid Accounts -->
    </mitre>
    <group>webapp_attack, authentication, access_control</group>
  </rule>

  <!-- Rule 100305: Sensitive Data Exposure -->
  <rule id="100305" level="9">
    <if_matched_group>juice_shop_data_exposure</if_matched_group>
    <description>Sensitive data exposure detected on Juice Shop (API keys, passwords, tokens)</description>
    <mitre>
      <id>T1526</id> <!-- Enumerate External Targets -->
      <id>T1589</id> <!-- Gather Victim Identity Information -->
    </mitre>
    <group>webapp_attack, data_exposure, credential_exposure</group>
  </rule>

  <!-- Rule 100306: File Upload Attack -->
  <rule id="100306" level="8">
    <if_matched_group>juice_shop_file_upload</if_matched_group>
    <description>Malicious file upload attempt detected on Juice Shop</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1059</id> <!-- Command and Scripting Interpreter -->
    </mitre>
    <group>webapp_attack, file_upload, rce</group>
  </rule>

  <!-- Rule 100307: Broken Access Control -->
  <rule id="100307" level="8">
    <if_matched_group>juice_shop_access_control</if_matched_group>
    <description>Broken Access Control (BACC) or privilege escalation attempt on Juice Shop</description>
    <mitre>
      <id>T1548</id> <!-- Abuse Elevation Control Mechanism -->
      <id>T1078</id> <!-- Valid Accounts -->
    </mitre>
    <group>webapp_attack, access_control, privilege_escalation</group>
  </rule>

  <!-- Rule 100308: BOLA (Broken Object Level Authorization) -->
  <rule id="100308" level="8">
    <if_matched_group>juice_shop_bola</if_matched_group>
    <description>BOLA or Direct Object Reference attempt on Juice Shop</description>
    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
      <id>T1526</id> <!-- Enumerate External Targets -->
    </mitre>
    <group>webapp_attack, access_control, enumeration</group>
  </rule>

  <!-- Rule 100309: Brute Force Attack on Juice Shop -->
  <rule id="100309" level="9">
    <if_matched_group>juice_shop_brute_force</if_matched_group>
    <frequency>5</frequency>
    <timeframe>60</timeframe>
    <description>Brute force attack detected on Juice Shop (multiple failed logins)</description>
    <mitre>
      <id>T1110</id> <!-- Brute Force -->
      <id>T1110.001</id> <!-- Brute Force: Password Guessing -->
    </mitre>
    <group>webapp_attack, brute_force, authentication</group>
  </rule>

  <!-- Rule 100310: Juice Shop Attack Summary -->
  <rule id="100310" level="10">
    <if_matched_sid>100301|100302|100303|100304|100305|100306|100307|100308</if_matched_sid>
    <frequency>2</frequency>
    <timeframe>120</timeframe>
    <description>Multiple attack vectors detected on Juice Shop (possible coordinated exploit)</description>
    <mitre>
      <id>T1587</id> <!-- Develop Capabilities -->
      <id>T1566</id> <!-- Phishing -->
    </mitre>
    <group>webapp_attack, coordinated_attack, high_severity</group>
  </rule>

  <!-- =====================================================================
