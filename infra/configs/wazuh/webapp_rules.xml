    <mitre>
      <id>T1190</id> <!-- Exploit Public-Facing Application -->
    </mitre>
    <group>webapp_training, sql_injection, learning</group>
  </rule>

  <!-- Rule 100321: WebGoat Authentication Lesson Activity -->
  <rule id="100321" level="5">
