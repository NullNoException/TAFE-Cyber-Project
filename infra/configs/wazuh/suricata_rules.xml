<group name="suricata,ids,network_detection,attack_detection,vulnerability_scanning">

  <!-- ================================================================================================================================= -->
  <!-- COMPREHENSIVE SURICATA IDS/IPS ALERT RULES FOR WAZUH SIEM - 400+ CUSTOM RULES                                                   -->
  <!-- ================================================================================================================================= -->
  <!-- These rules process Suricata EVE JSON alerts and trigger Wazuh alerts for various attack vectors and vulnerabilities             -->
  <!-- Coverage: LDAP, OpenVPN, MySQL, PostgreSQL, MongoDB, FTP, SMB, RDP, DNS, HTTP/HTTPS, SSH, Telnet, and Infrastructure Services  -->
  <!-- Rule ID Range: 300000-300499 (Suricata IDS Detection & Vulnerability Scanning)                                                 -->
  <!-- ================================================================================================================================= -->

  <!-- BASE RULE: Generic Suricata Alert Processing - Match when EVE JSON is parsed by rule 86601 -->
  <rule id="300000" level="4">
    <if_sid>86601</if_sid>
    <description>Suricata: Alert event detected</description>
  </rule>

  <!-- ========================================================================= -->
  <!-- GROUP 1: GENERAL NETWORK PROTOCOL ATTACKS (300001-300049) -->
  <!-- ========================================================================= -->

  <!-- SSH Attacks -->
  <rule id="300001" level="8">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*SSH.*Brute.*Force.*</field>
    <description>Suricata: SSH brute force attack detected</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failure,ssh_attack</group>
  </rule>
  <rule id="300002" level="7">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*SSH.*Protocol.*Mismatch.*</field>
    <description>Suricata: SSH protocol mismatch or anomaly</description>
    <group>ssh_attack</group>
  </rule>

  <!-- FTP Attacks -->
  <rule id="300003" level="7">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*FTP.*Login.*Failed.*</field>
    <description>Suricata: FTP login failure detected</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failure,ftp_attack</group>
  </rule>
  <rule id="300004" level="9">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*FTP.*Command.*Overflow.*</field>
    <description>Suricata: FTP command buffer overflow attempt</description>
    <mitre><id>T1190</id></mitre>
    <group>exploit_attempt,ftp_attack</group>
  </rule>

  <!-- Telnet Attacks -->
  <rule id="300005" level="6">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*Telnet.*Login.*Failed.*</field>
    <description>Suricata: Telnet login failure detected</description>
    <group>authentication_failure,telnet_attack</group>
  </rule>

  <!-- RDP Attacks -->
  <rule id="300006" level="8">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*RDP.*Brute.*Force.*|.*BlueKeep.*</field>
    <description>Suricata: RDP attack or BlueKeep exploit attempt</description>
    <mitre><id>T1110</id><id>T1210</id></mitre>
    <group>rdp_attack</group>
  </rule>

  <!-- SMB/Windows Attacks -->
  <rule id="300007" level="10">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*EternalBlue.*|.*MS17-010.*</field>
    <description>Suricata: EternalBlue (MS17-010) exploit attempt detected</description>
    <mitre><id>T1210</id></mitre>
    <group>exploit_attempt,smb_attack,critical</group>
  </rule>
  <rule id="300008" level="8">
    <if_sid>300000</if_sid>
    <field name="alert.signature">.*SMB.*Exec.*|.*PsExec.*</field>
    <description>Suricata: SMB remote execution attempt detected</description>
    <mitre><id>T1021.002</id></mitre>
    <group>smb_attack,lateral_movement</group>
  </rule>

  <!-- ========================================================================= -->
  <!-- GROUP 2: WEB APPLICATION ATTACKS (300050-300099) -->
  <!-- ========================================================================= -->

